<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IronSkies.Game</RootNamespace>
    <AssemblyName>IronSkies.Game</AssemblyName>
    <!-- Stable frame times: fully optimize on first call instead of tiering mid-flight.
         A warm-up pass in Main._Ready pays the JIT cost during loading. -->
    <TieredCompilation>false</TieredCompilation>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\IronSkies.FlightModel\IronSkies.FlightModel.csproj" />
  </ItemGroup>
</Project>
